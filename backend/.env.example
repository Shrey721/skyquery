# Application Database (Primary)
# Defaults to local SQLite if omitted. Override for production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/skyquery

# Analytical Database (Trino) Configuration
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=aviation
TRINO_SCHEMA=public

# Caching and Session Storage
# Used for storing Copilot tokens and metadata schemas
REDIS_URL=redis://localhost:6379/0

# Environment Settings
MOCK_EXECUTION=true

# Standard LLM Configuration (Overrides GitHub Copilot if set)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
